{
	"schemaVersion": 1,
	"id": "patchwork",
	"version": "${version}",
	"name": "Patchwork",
	"description": "Client-sided hotkey and custom item used to place random items from your hotbar or inventory!",
	"authors": [
		"Cuebitt"
	],
	"contact": {
		"homepage": "https://github.com/cuebitt/patchwork",
		"sources": "https://github.com/cuebitt/patchwork"
	},
	"license": "MIT",
	"icon": "assets/patchwork/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"cuebitt.patchwork.client.PatchworkClient"
		],
		"modmenu": [
			"cuebitt.patchwork.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"patchwork.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}